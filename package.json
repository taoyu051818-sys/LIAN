{
  "name": "lian-platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LIAN backend runtime using the Redis object-native data model",
  "keywords": [
    "lian",
    "backend",
    "redis",
    "object-native",
    "nodebb"
  ],
  "scripts": {
    "audit:feed-images": "node scripts/audit-feed-image-coverage.js",
    "audit:feed-images:strict": "node scripts/audit-feed-image-coverage.js --min-coverage=0.8",
    "check": "node scripts/validate-backend-structure.js && node scripts/check-encoding-contamination.js",
    "check:backend": "node scripts/validate-backend-structure.js",
    "check:encoding": "node scripts/check-encoding-contamination.js",
    "legacy:cleanup:bulk": "node scripts/legacy/delete-redis-legacy-bulk-keys.js",
    "legacy:migrate:bulk": "node scripts/legacy/migrate-data-to-redis.js",
    "legacy:migrate:objects": "node scripts/legacy/migrate-redis-object-keys.js",
    "legacy:test:auth": "node scripts/legacy/test-redis-auth-object-indexes.js",
    "legacy:test:objects": "node scripts/legacy/test-redis-object-store.js",
    "legacy:verify:bulk": "node scripts/legacy/verify-redis-migration.js",
    "legacy:verify:bulk:prod": "node scripts/legacy/verify-redis-migration.js --allow-growth",
    "legacy:verify:objects": "node scripts/legacy/verify-redis-object-keys.js",
    "start": "node server.js",
    "test": "node --test test/*.test.mjs",
    "test:object-native": "node scripts/test-object-native-runtime.js",
    "test:ops-actions": "node scripts/test-ops-actions.js",
    "test:route-manifest": "node scripts/test-route-manifest.js",
    "test:routes": "node scripts/test-routes.js",
    "verify": "npm run check && npm run test:routes && npm run test:route-manifest && npm run test:ops-actions && npm run test:object-native && npm run verify:redis && npm run verify:redis:auth && npm run audit:feed-images",
    "verify:public": "node scripts/verify-public-entry.js",
    "verify:redis": "node scripts/verify-redis-object-primary.js",
    "verify:redis:auth": "node scripts/verify-redis-auth-object-indexes.js",
    "verify:redis:object-primary": "node scripts/verify-redis-object-primary.js",
    "verify:redis:objects": "node scripts/verify-redis-object-primary.js",
    "verify:redis:prod": "node scripts/verify-redis-object-primary.js"
  },
  "lian": {
    "dataModel": "redis-object-native",
    "docs": [
      "README.md",
      "docs/architecture/redis-object-native-data-model.md"
    ],
    "redis": {
      "runtime": "Redis object keys are the source of truth for normal reads and writes.",
      "legacyBulkKeys": "Legacy bulk JSON keys are intentionally absent from a healthy object-native runtime.",
      "primaryVerificationScripts": [
        "test:object-native",
        "verify:redis",
        "verify:redis:auth"
      ],
      "legacyScriptsPrefix": "legacy:*",
      "legacyScriptsPurpose": "Historical migration and bulk-verification helpers only; do not use for normal runtime verification.",
      "requiredEnv": {
        "LIAN_STORAGE_MODE": "db",
        "LIAN_REDIS_OBJECT_READS": "true",
        "LIAN_REDIS_OBJECT_PRIMARY": "true",
        "LIAN_AUTH_OBJECT_READS": "true",
        "LIAN_AUTH_OBJECT_NATIVE": "true"
      }
    }
  },
  "dependencies": {
    "redis": "^4.7.0"
  }
}
