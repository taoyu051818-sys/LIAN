{
  "name": "lian-platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "check": "node scripts/validate-backend-structure.js && node scripts/check-encoding-contamination.js",
    "check:encoding": "node scripts/check-encoding-contamination.js",
    "test": "node --test test/*.test.mjs",
    "test:routes": "node scripts/test-routes.js",
    "check:backend": "node scripts/validate-backend-structure.js",
    "migrate:redis": "node scripts/migrate-data-to-redis.js",
    "verify:redis": "node scripts/verify-redis-migration.js",
    "verify:redis:prod": "node scripts/verify-redis-migration.js --allow-growth",
    "migrate:redis:objects": "node scripts/migrate-redis-object-keys.js",
    "verify:redis:objects": "node scripts/verify-redis-object-keys.js",
    "test:redis:objects": "node scripts/test-redis-object-store.js",
    "test:redis:auth": "node scripts/test-redis-auth-object-indexes.js",
    "verify:redis:auth": "node scripts/verify-redis-auth-object-indexes.js"
  },
  "dependencies": {
    "redis": "^4.7.0"
  },
  "description": "Backend runtime for LIAN"
}
