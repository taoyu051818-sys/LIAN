{
  "name": "lian-platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/validate-backend-structure.js && node scripts/check-encoding-contamination.js",
    "check:backend": "node scripts/validate-backend-structure.js",
    "check:encoding": "node scripts/check-encoding-contamination.js",
    "legacy:cleanup:bulk": "node scripts/legacy/delete-redis-legacy-bulk-keys.js",
    "legacy:migrate:bulk": "node scripts/legacy/migrate-data-to-redis.js",
    "legacy:migrate:objects": "node scripts/legacy/migrate-redis-object-keys.js",
    "legacy:test:auth": "node scripts/legacy/test-redis-auth-object-indexes.js",
    "legacy:test:objects": "node scripts/legacy/test-redis-object-store.js",
    "legacy:verify:bulk": "node scripts/legacy/verify-redis-migration.js",
    "legacy:verify:bulk:prod": "node scripts/legacy/verify-redis-migration.js --allow-growth",
    "legacy:verify:objects": "node scripts/legacy/verify-redis-object-keys.js",
    "start": "node server.js",
    "test": "node --test test/*.test.mjs",
    "test:object-native": "node scripts/test-object-native-runtime.js",
    "test:routes": "node scripts/test-routes.js",
    "verify:redis": "node scripts/verify-redis-object-primary.js",
    "verify:redis:auth": "node scripts/verify-redis-auth-object-indexes.js",
    "verify:redis:object-primary": "node scripts/verify-redis-object-primary.js",
    "verify:redis:objects": "node scripts/verify-redis-object-primary.js",
    "verify:redis:prod": "node scripts/verify-redis-object-primary.js"
  },
  "dependencies": {
    "redis": "^4.7.0"
  },
  "description": "Backend runtime for LIAN"
}
